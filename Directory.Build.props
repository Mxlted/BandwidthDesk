<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <Authors>BandwidthDesk Contributors</Authors>
    <Company>BandwidthDesk</Company>
    <Product>BandwidthDesk</Product>
    <Version>0.1.1</Version>
    <RepositoryUrl>https://github.com/Mxlted/BandwidthDesk</RepositoryUrl>
  </PropertyGroup>
</Project>
