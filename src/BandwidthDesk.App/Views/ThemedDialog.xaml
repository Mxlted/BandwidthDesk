<Window x:Class="BandwidthDesk.App.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BandwidthDesk"
        Icon="pack://application:,,,/Resources/icon.ico"
        SizeToContent="Height" Width="470"
        MinHeight="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,13,0"
                        Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock x:Name="IconText" FontSize="19" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderText" Style="{StaticResource Text.Header}"
                               TextWrapping="Wrap" MaxWidth="340" Margin="0,0,0,5" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" MaxWidth="340" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="NoButton" Content="No" MinWidth="88" Margin="0,0,8,0"
                    Click="No_Click" Visibility="Collapsed" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" Margin="0,0,8,0"
                    Click="Cancel_Click" IsCancel="True" Visibility="Collapsed" />
            <Button x:Name="PrimaryButton" Content="OK" MinWidth="96" IsDefault="True"
                    Style="{StaticResource Button.Accent}" Click="Primary_Click" />
        </StackPanel>
    </Grid>
</Window>
