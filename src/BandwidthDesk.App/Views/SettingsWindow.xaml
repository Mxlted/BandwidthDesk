<Window x:Class="BandwidthDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BandwidthDesk Settings"
        Icon="pack://application:,,,/Resources/icon.ico"
        Height="760" Width="900"
        MinHeight="640" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="13">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconBadge}" Width="44" Height="44" Margin="0,0,12,0">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="18"
                           Foreground="{DynamicResource Brush.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Tune the experience, manage profiles, and find diagnostics."
                           Style="{StaticResource Text.Muted}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Changes apply instantly across every window."
                                       Style="{StaticResource Text.Subtle}" Margin="0,2,0,14" />

                            <TextBlock Text="COLOR THEME" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,7" />
                            <Border Padding="4" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Theme" Style="{StaticResource Button.Segment}"
                                                 Content="Dark" IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                                    <RadioButton GroupName="Theme" Style="{StaticResource Button.Segment}"
                                                 Content="Light" IsChecked="{Binding IsThemeLight, Mode=TwoWay}" />
                                    <RadioButton GroupName="Theme" Style="{StaticResource Button.Segment}"
                                                 Content="OLED" IsChecked="{Binding IsThemeOled, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="DEFAULT RATE UNIT" Style="{StaticResource Text.Eyebrow}" Margin="0,16,0,7" />
                            <Border Padding="4" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="RateUnit" Style="{StaticResource Button.Segment}"
                                                 Content="B/s" IsChecked="{Binding IsUnitBps, Mode=TwoWay}" />
                                    <RadioButton GroupName="RateUnit" Style="{StaticResource Button.Segment}"
                                                 Content="KB/s" IsChecked="{Binding IsUnitKBps, Mode=TwoWay}" />
                                    <RadioButton GroupName="RateUnit" Style="{StaticResource Button.Segment}"
                                                 Content="MB/s" IsChecked="{Binding IsUnitMBps, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Process discovery" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Control what appears and how often it refreshes."
                                       Style="{StaticResource Text.Subtle}" Margin="0,2,0,14" />

                            <CheckBox Content="Hide Microsoft and system processes"
                                      IsChecked="{Binding HideMicrosoftProcesses, Mode=TwoWay}"
                                      ToolTip="Filter Microsoft-signed apps and processes under the Windows folder" />

                            <TextBlock Text="REFRESH INTERVAL" Style="{StaticResource Text.Eyebrow}" Margin="0,16,0,7" />
                            <Border Padding="4" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Refresh" Style="{StaticResource Button.Segment}"
                                                 Content="Fast · 1s" IsChecked="{Binding IsRefreshFast, Mode=TwoWay}" />
                                    <RadioButton GroupName="Refresh" Style="{StaticResource Button.Segment}"
                                                 Content="Normal · 3s" IsChecked="{Binding IsRefreshNormal, Mode=TwoWay}" />
                                    <RadioButton GroupName="Refresh" Style="{StaticResource Button.Segment}"
                                                 Content="Slow · 10s" IsChecked="{Binding IsRefreshSlow, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Window behavior" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Keep BandwidthDesk available without desktop clutter."
                                       Style="{StaticResource Text.Subtle}" Margin="0,2,0,14" />

                            <CheckBox Content="Minimize to notification area"
                                      IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                            <CheckBox Margin="0,12,0,0" Content="Close button sends app to notification area"
                                      IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                            <CheckBox Margin="0,12,0,0" Content="Show a tray hint the first time"
                                      IsChecked="{Binding ShowTrayNotifications, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Data and diagnostics" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Everything stays local on this PC."
                                       Style="{StaticResource Text.Subtle}" Margin="0,2,0,14" />

                            <Button HorizontalContentAlignment="Left" Command="{Binding OpenDataFolderCommand}" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE838;" Margin="0,0,9,0" />
                                    <TextBlock Text="Open data folder" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalContentAlignment="Left" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D2;" Margin="0,0,9,0" />
                                    <TextBlock Text="Open logs folder" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalContentAlignment="Left" Command="{Binding OpenProfilesFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Margin="0,0,9,0" />
                                    <TextBlock Text="Open profiles folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Profiles" Style="{StaticResource Text.Header}" />
                                <TextBlock Text="Save the current rules and key preferences for work, gaming, or streaming."
                                           Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Import…" Command="{Binding ImportProfileCommand}" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Name this snapshot" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Accent}"
                                    Content="Save current as profile" Command="{Binding SaveCurrentAsProfileCommand}" />
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Corner.Md}" Background="{DynamicResource Brush.SurfaceAlt}">
                            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource Pill}" Padding="8,2"
                                                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="Transparent">
                                                <TextBlock Text="PROFILE" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Accent}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Text="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,8" />
                                        <Setter Property="Margin" Value="4,2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Item" Background="{TemplateBinding Background}"
                                                            CornerRadius="{StaticResource Corner.Sm}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Subtle}"
                                       Text="Applying a profile replaces the current rule set after confirmation." />
                            <Button Grid.Column="1" Margin="0,0,7,0" Content="Export…" Command="{Binding ExportProfileCommand}" />
                            <Button Grid.Column="2" Margin="0,0,7,0" Style="{StaticResource Button.Danger}"
                                    Content="Delete" Command="{Binding DeleteProfileCommand}" />
                            <Button Grid.Column="3" Style="{StaticResource Button.Accent}"
                                    Content="Apply profile" Command="{Binding ApplyProfileCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="2,14,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource Text.Muted}" Text="{Binding StatusMessage}" />
            <Button Grid.Column="1" Content="Done" MinWidth="96" Click="Close_Click" IsDefault="True" IsCancel="True"
                    AutomationProperties.Name="Done" />
        </Grid>
    </Grid>
</Window>
