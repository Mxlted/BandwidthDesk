<Window x:Class="BandwidthDesk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BandwidthDesk.App.ViewModels"
        Title="BandwidthDesk Settings"
        Icon="pack://application:,,,/Resources/icon.ico"
        SizeToContent="Height" Width="780"
        MaxHeight="860" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource Brush.Bg}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Settings" Style="{StaticResource Text.Display}" />
            <TextBlock Text="Appearance, behaviour, and saved profiles"
                       Style="{StaticResource Text.Muted}" />
        </StackPanel>

        <!-- Appearance card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource Text.Header}" />
                <TextBlock Text="Switch the colour palette. Changes apply instantly across the app."
                           Style="{StaticResource Text.Subtle}" Margin="0,2,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Card}" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Theme" Style="{StaticResource Button.Segment}"
                                         Content="Dark" IsChecked="{Binding IsThemeDark, Mode=TwoWay}" />
                            <RadioButton GroupName="Theme" Style="{StaticResource Button.Segment}"
                                         Content="Light" IsChecked="{Binding IsThemeLight, Mode=TwoWay}" />
                            <RadioButton GroupName="Theme" Style="{StaticResource Button.Segment}"
                                         Content="OLED" IsChecked="{Binding IsThemeOled, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <CheckBox Margin="0,16,0,0"
                          Content="Hide Microsoft / system processes by default"
                          IsChecked="{Binding HideMicrosoftProcesses, Mode=TwoWay}"
                          ToolTip="Filter out processes signed by Microsoft or running from C:\Windows" />

                <TextBlock Text="Default rate unit"
                           Style="{StaticResource Text.Subtle}" Margin="0,18,0,6" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,8"
                           Text="Pre-selected unit when creating a new bandwidth rule." />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Card}" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="RateUnit" Style="{StaticResource Button.Segment}"
                                         Content="B/s" IsChecked="{Binding IsUnitBps, Mode=TwoWay}" />
                            <RadioButton GroupName="RateUnit" Style="{StaticResource Button.Segment}"
                                         Content="KB/s" IsChecked="{Binding IsUnitKBps, Mode=TwoWay}" />
                            <RadioButton GroupName="RateUnit" Style="{StaticResource Button.Segment}"
                                         Content="MB/s" IsChecked="{Binding IsUnitMBps, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="Process list refresh"
                           Style="{StaticResource Text.Subtle}" Margin="0,18,0,6" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,8"
                           Text="How often the running-process list re-scans. Faster feels snappier; slower uses less CPU." />
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Card}" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Refresh" Style="{StaticResource Button.Segment}"
                                         Content="Fast (1s)" IsChecked="{Binding IsRefreshFast, Mode=TwoWay}" />
                            <RadioButton GroupName="Refresh" Style="{StaticResource Button.Segment}"
                                         Content="Normal (3s)" IsChecked="{Binding IsRefreshNormal, Mode=TwoWay}" />
                            <RadioButton GroupName="Refresh" Style="{StaticResource Button.Segment}"
                                         Content="Slow (10s)" IsChecked="{Binding IsRefreshSlow, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Profiles card -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Profiles" Style="{StaticResource Text.Header}" />
                    <TextBlock Style="{StaticResource Text.Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="A profile is a saved snapshot of your rule set plus a few preferences. Save profiles for different scenarios (work, gaming, streaming) and switch between them with one click. Profiles can be exported to a JSON file and shared between PCs." />
                </StackPanel>

                <!-- Save current as new profile -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name for a new profile snapshot of the current rule set" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Accent}"
                            Content="Save current as profile"
                            Command="{Binding SaveCurrentAsProfileCommand}" />
                </Grid>

                <!-- Action row for the selected saved profile -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Subtle}"
                                   Text="Import from a .json file or open the folder where profiles live." />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="0,0,6,0"
                            Content="Import…" Command="{Binding ImportProfileCommand}" />
                    <Button Grid.Column="2" Margin="0,0,6,0"
                            Content="Export…" Command="{Binding ExportProfileCommand}" />
                    <Button Grid.Column="3" Margin="0,0,6,0" Style="{StaticResource Button.Danger}"
                            Content="Delete" Command="{Binding DeleteProfileCommand}" />
                    <Button Grid.Column="4" Style="{StaticResource Button.Accent}"
                            Content="Apply" Command="{Binding ApplyProfileCommand}" />
                </Grid>

                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Corner.Sm}">
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MinHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Pill}" Padding="8,2"
                                            Background="{DynamicResource Brush.AccentSoft}"
                                            BorderBrush="Transparent">
                                        <TextBlock Text="profile" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Text="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="SnapsToDevicePixels" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="{StaticResource Corner.Sm}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Brush.SurfaceHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource Brush.Selection}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>

        <!-- Export-current shortcut -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Subtle}" TextWrapping="Wrap"
                       Text="{Binding ProfilesDirectory, StringFormat='Profiles folder: {0}'}" />
            <Button Grid.Column="1" Margin="8,0,6,0" Content="Open profiles folder"
                    Command="{Binding OpenProfilesFolderCommand}" />
            <Button Grid.Column="2" Content="Open data folder"
                    Command="{Binding OpenDataFolderCommand}" />
        </Grid>

        <!-- Status / close -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource Text.Muted}" Text="{Binding StatusMessage}" />
            <Button Grid.Column="1" Content="Close" MinWidth="96" Click="Close_Click" />
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
