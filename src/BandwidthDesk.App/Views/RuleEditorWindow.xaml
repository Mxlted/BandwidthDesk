<Window x:Class="BandwidthDesk.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bandwidth rule"
        Height="620" Width="620"
        MinHeight="620" MinWidth="620"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Bg}">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource IconBadge}" Width="44" Height="44" Margin="0,0,12,0">
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="18"
                           Foreground="{DynamicResource Brush.Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" Text="Create a bandwidth rule" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Choose what to match, then set an independent limit for each direction."
                           Style="{StaticResource Text.Muted}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="RULE NAME" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
                    <TextBox x:Name="NameBox" ToolTip="A friendly label shown in the rules list" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="MATCH BY" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
                        <ComboBox x:Name="MatchKindBox" SelectionChanged="MatchKindBox_SelectionChanged">
                            <ComboBoxItem Content="Executable name" Tag="ExecutableName" />
                            <ComboBoxItem Content="Process ID" Tag="ProcessId" />
                            <ComboBoxItem Content="Executable path" Tag="ExecutablePath" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="MatchValueLabel" Text="MATCH VALUE" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
                        <TextBox x:Name="MatchValueBox" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="14" CornerRadius="{StaticResource Corner.Md}"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="↓" Foreground="{DynamicResource Brush.Accent}" FontSize="16" FontWeight="Bold" Margin="0,0,7,0" />
                                <TextBlock Text="Download limit" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="DownloadValueBox"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         DataObject.Pasting="NumericOnly_OnPaste" />
                                <ComboBox Grid.Column="2" x:Name="DownloadUnitBox" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="14" CornerRadius="{StaticResource Corner.Md}"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="↑" Foreground="{DynamicResource Brush.Success}" FontSize="16" FontWeight="Bold" Margin="0,0,7,0" />
                                <TextBlock Text="Upload limit" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="UploadValueBox"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         DataObject.Pasting="NumericOnly_OnPaste" />
                                <ComboBox Grid.Column="2" x:Name="UploadUnitBox" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Padding="12,10" CornerRadius="10" Margin="0,0,0,14"
                        Background="{DynamicResource Brush.AccentSoft}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="i" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Style="{StaticResource Text.Muted}"
                                   Text="Use 0 for unlimited. Positive values must be at least 1 KB/s; units use 1024-byte multiples." />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Enabled" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <CheckBox x:Name="EnabledBox" Style="{StaticResource CheckBox.Switch}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Subtle}"
                       Text="Rules apply immediately after saving." />
            <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" IsCancel="True"
                    Margin="0,0,8,0" MinWidth="92" />
            <Button Grid.Column="2" Style="{StaticResource Button.Accent}" Content="Save rule"
                    Click="Save_Click" IsDefault="True" MinWidth="108" />
        </Grid>
    </Grid>
</Window>
