<Window x:Class="BandwidthDesk.App.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BandwidthDesk.App.ViewModels"
        xmlns:conv="clr-namespace:BandwidthDesk.App.Converters"
        Title="BandwidthDesk" Height="760" Width="1280"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        MinHeight="560" MinWidth="980"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="13">
    <Window.Resources>
        <conv:ByteRateConverter x:Key="RateConv" />
        <conv:ByteSizeConverter x:Key="SizeConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EngineStatusToBrushConverter x:Key="StatusBrush" />
        <conv:RateActivityConverter x:Key="RateActivity" />
        <conv:SortHeaderTextConverter x:Key="SortHeaderText" />

        <!-- Clickable column-sort header. ContentStringFormat used as the sort key name. -->
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}" />
        </Style>

        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:ProcessGroupViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,12,0" Style="{StaticResource Text.Subtle}"
                           Text="{Binding InstanceCountLabel}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,12,0" Style="{StaticResource Text.Mono}"
                           Text="{Binding TotalWorkingSetBytes, Converter={StaticResource SizeConv}}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,12,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentDownloadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,4,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentUploadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChildTemplate" DataType="{x:Type vm:ProcessRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                    <Border Style="{StaticResource Pill}" Padding="6,1">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding ProcessId}" />
                    </Border>
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                               Style="{StaticResource Text.Subtle}" TextTrimming="CharacterEllipsis"
                               Text="{Binding ExecutablePath}" />
                </StackPanel>
                <TextBlock Grid.Column="1" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,12,0" Style="{StaticResource Text.Mono}"
                           Text="{Binding WorkingSetBytes, Converter={StaticResource SizeConv}}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,12,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentDownloadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,4,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentUploadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="BandwidthDesk" Style="{StaticResource Text.Display}" />
                <TextBlock Text="Per-process upload and download limits for Windows"
                           Style="{StaticResource Text.Muted}" />
            </StackPanel>

            <!-- Settings entry point -->
            <Button Grid.Column="1" VerticalAlignment="Center" Padding="14,7" MinWidth="110"
                    Command="{Binding OpenSettingsCommand}"
                    ToolTip="Theme, profiles, import / export">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙" FontSize="14" Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Engine status pill -->
            <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="10,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="2,0,8,0"
                             Fill="{Binding EngineStatus, Converter={StaticResource StatusBrush}}" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding EngineStatus}" />
                    <TextBlock Margin="8,0,2,0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}" MaxWidth="380"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding EngineStatusMessage}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Totals -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="DOWNLOAD" Style="{StaticResource Text.Subtle}" />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"
                               Text="{Binding TotalDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="UPLOAD" Style="{StaticResource Text.Subtle}" />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"
                               Text="{Binding TotalUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Elevation warning -->
        <Border Grid.Row="2" Style="{StaticResource Card}"
                Background="{DynamicResource Brush.DangerSoft}"
                BorderBrush="{DynamicResource Brush.Danger}"
                Padding="14,10"
                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Danger}" />
                <TextBlock VerticalAlignment="Center"
                           Text="BandwidthDesk is not running as Administrator. Rules can be edited and saved, but they will not be enforced until the app is relaunched with elevation." />
            </StackPanel>
        </Border>

        <!-- Main panes -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Processes -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Running processes" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Grouped by application — expand for individual instances"
                                       Style="{StaticResource Text.Subtle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Content="Hide Microsoft" IsChecked="{Binding HideMicrosoftProcesses, Mode=TwoWay}"
                                  ToolTip="Hide processes signed by Microsoft or running from C:\Windows" />
                        <TextBox Grid.Column="2" Width="200" Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 ToolTip="Filter by name, description, or publisher" />
                        <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshProcessesCommand}" />
                    </Grid>

                    <Button DockPanel.Dock="Bottom" Margin="0,12,0,0" HorizontalAlignment="Stretch"
                            Style="{StaticResource Button.Accent}"
                            Content="Limit selected…"
                            Command="{Binding NewRuleFromSelectedProcessCommand}" />

                    <!-- Column header strip (click to sort) -->
                    <Grid DockPanel.Dock="Top" Margin="22,0,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SortHeader}" HorizontalAlignment="Left"
                                Command="{Binding SetSortCommand}" CommandParameter="Name">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SortHeaderText}">
                                        <Binding Source="NAME" />
                                        <Binding Source="Name" />
                                        <Binding Path="SortKey" />
                                        <Binding Path="SortDescending" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Instances">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SortHeaderText}">
                                        <Binding Source="INSTANCES" />
                                        <Binding Source="Instances" />
                                        <Binding Path="SortKey" />
                                        <Binding Path="SortDescending" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Memory">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SortHeaderText}">
                                        <Binding Source="MEMORY" />
                                        <Binding Source="Memory" />
                                        <Binding Path="SortKey" />
                                        <Binding Path="SortDescending" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Download">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SortHeaderText}">
                                        <Binding Source="DOWN" />
                                        <Binding Source="Download" />
                                        <Binding Path="SortKey" />
                                        <Binding Path="SortDescending" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Upload">
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource SortHeaderText}">
                                        <Binding Source="UP" />
                                        <Binding Source="Upload" />
                                        <Binding Path="SortKey" />
                                        <Binding Path="SortDescending" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <TreeView x:Name="ProcessTree"
                              ItemsSource="{Binding ProcessGroups}"
                              SelectedItemChanged="ProcessTree_OnSelectedItemChanged"
                              MouseDoubleClick="ProcessTree_OnMouseDoubleClick"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:ProcessGroupViewModel}"
                                                      ItemsSource="{Binding Children}"
                                                      ItemTemplate="{StaticResource ChildTemplate}">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GroupTemplate}" />
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProcessItem_OnPreviewRightClick" />
                                <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootWindow}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <MenuItem Header="Add bandwidth limit…"
                                                      Command="{Binding PlacementTarget.Tag.NewRuleFromProcessNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Edit existing rule…"
                                                      Command="{Binding PlacementTarget.Tag.EditRuleForProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Rules -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Bandwidth rules" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Saved limits applied by the engine"
                                       Style="{StaticResource Text.Subtle}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="New" Command="{Binding NewBlankRuleCommand}" Margin="0,0,6,0" />
                            <Button Content="Edit" Command="{Binding EditRuleCommand}" Margin="0,0,6,0" />
                            <Button Style="{StaticResource Button.Danger}" Content="Delete" Command="{Binding DeleteRuleCommand}" />
                        </StackPanel>
                    </Grid>

                    <ListView ItemsSource="{Binding Rules}"
                              SelectedItem="{Binding SelectedRule}"
                              MouseDoubleClick="RulesList_OnMouseDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="RuleItem_OnPreviewRightClick" />
                                <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootWindow}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Edit…" Command="{Binding EditRuleCommand}" />
                                            <MenuItem Header="Toggle enabled" Command="{Binding ToggleSelectedRuleCommand}" />
                                            <Separator />
                                            <MenuItem Header="Delete" Command="{Binding DeleteRuleCommand}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="On" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                      Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Target" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MatchSummary}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource Text.Muted}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Down cap" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Mono}"
                                                       Text="{Binding DownloadBytesPerSecond, Converter={StaticResource RateConv}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Up cap" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Mono}"
                                                       Text="{Binding UploadBytesPerSecond, Converter={StaticResource RateConv}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Live D / U" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Text.Mono}"
                                                           Foreground="{Binding CurrentDownloadBps, Converter={StaticResource RateActivity}}"
                                                           Text="{Binding CurrentDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                                                <TextBlock Text="  /  " Style="{StaticResource Text.Subtle}" />
                                                <TextBlock Style="{StaticResource Text.Mono}"
                                                           Foreground="{Binding CurrentUploadBps, Converter={StaticResource RateActivity}}"
                                                           Text="{Binding CurrentUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,14,0,0">
            <TextBlock Style="{StaticResource Text.Subtle}"
                       Text="Rules saved to %LOCALAPPDATA%\BandwidthDesk\rules.json · Logs in %LOCALAPPDATA%\BandwidthDesk\logs\" />
        </StackPanel>
    </Grid>
</Window>
