<Window x:Class="BandwidthDesk.App.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BandwidthDesk.App.ViewModels"
        xmlns:conv="clr-namespace:BandwidthDesk.App.Converters"
        Title="BandwidthDesk"
        Height="820" Width="1440"
        MinHeight="680" MinWidth="1120"
        Icon="pack://application:,,,/Resources/icon.ico"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Bg}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Default}"
        FontSize="13">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshProcessesCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewBlankRuleCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <conv:ByteRateConverter x:Key="RateConv" />
        <conv:ByteSizeConverter x:Key="SizeConv" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EngineStatusToBrushConverter x:Key="StatusBrush" />
        <conv:RateActivityConverter x:Key="RateActivity" />
        <conv:SortHeaderTextConverter x:Key="SortHeaderText" />

        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSubtle}" />
        </Style>

        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="CornerRadius" Value="{StaticResource Corner.Md}" />
            <Setter Property="MinHeight" Value="88" />
        </Style>

        <Style x:Key="RuleListItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Selection" Background="Transparent" CornerRadius="{StaticResource Corner.Md}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:ProcessGroupViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,2" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0"
                            Background="{DynamicResource Brush.SurfaceAlt}">
                        <Image Source="{Binding Icon}" Width="18" Height="18"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Subtle}"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0" Style="{StaticResource Text.Subtle}"
                           Text="{Binding InstanceCountLabel}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0" Style="{StaticResource Text.Mono}"
                           Text="{Binding TotalWorkingSetBytes, Converter={StaticResource SizeConv}}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentDownloadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,4,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentUploadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChildTemplate" DataType="{x:Type vm:ProcessRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" Padding="7,2" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding ProcessId}" />
                    </Border>
                    <TextBlock Style="{StaticResource Text.Subtle}" VerticalAlignment="Center"
                               MaxWidth="280" TextTrimming="CharacterEllipsis"
                               Text="{Binding ExecutablePath}" />
                </StackPanel>
                <TextBlock Grid.Column="1" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0" Style="{StaticResource Text.Mono}"
                           Text="{Binding WorkingSetBytes, Converter={StaticResource SizeConv}}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,10,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentDownloadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="0,0,4,0" Style="{StaticResource Text.Mono}"
                           Foreground="{Binding CurrentUploadBps, Converter={StaticResource RateActivity}}"
                           Text="{Binding CurrentUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RuleCardTemplate" DataType="{x:Type vm:RuleRowViewModel}">
            <Border Padding="14" Margin="2" CornerRadius="{StaticResource Corner.Md}"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource CheckBox.Switch}" Margin="0,0,10,0"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}"
                                  Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  ToolTip="Enable or disable this rule" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding MatchSummary}" Style="{StaticResource Text.Subtle}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}"
                                CornerRadius="{StaticResource Corner.Sm}"
                                Width="48" Height="32" Padding="0" Margin="8,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="Transparent"
                                Visibility="{Binding IsActivelyLimited, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ACTIVE" FontSize="9" FontWeight="Bold"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       TextAlignment="Center" Margin="0,1,0,0"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                        <Button Grid.Column="3" Style="{StaticResource Button.Ghost}" Padding="8,5"
                                ToolTip="Edit rule"
                                AutomationProperties.Name="Edit rule"
                                Command="{Binding DataContext.EditRuleForRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DOWNLOAD LIMIT" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.MonoStrong}"
                                       Text="{Binding DownloadBytesPerSecond, Converter={StaticResource RateConv}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="UPLOAD LIMIT" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.MonoStrong}"
                                       Text="{Binding UploadBytesPerSecond, Converter={StaticResource RateConv}}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,8" CornerRadius="9"
                            Background="{DynamicResource Brush.Surface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LIVE" Style="{StaticResource Text.Eyebrow}"
                                       Margin="0,0,14,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↓" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" />
                                <TextBlock Margin="6,0,12,0" Style="{StaticResource Text.Mono}"
                                           Foreground="{Binding CurrentDownloadBps, Converter={StaticResource RateActivity}}"
                                           Text="{Binding CurrentDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="↑" Foreground="{DynamicResource Brush.Success}" FontWeight="Bold" />
                                <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Mono}"
                                           Foreground="{Binding CurrentUploadBps, Converter={StaticResource RateActivity}}"
                                           Text="{Binding CurrentUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Application shell header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0"
                        Background="{DynamicResource Brush.AccentSoft}">
                    <Image Source="pack://application:,,,/Resources/icon.png" Width="28" Height="28" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BandwidthDesk" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="Network control for every app" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource Status.Squircle}" Margin="0,0,10,0"
                    MinWidth="184" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,9,0"
                            Background="{DynamicResource Brush.AccentSoft}" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 Fill="{Binding EngineStatus, Converter={StaticResource StatusBrush}}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding EngineStatusMessage}" Style="{StaticResource Text.Subtle}"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}"
                    Padding="13,9" ToolTip="Appearance, profiles, and app behavior"
                    AutomationProperties.Name="Settings">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" FontSize="15" Margin="0,0,8,0" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Non-elevated mode -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14"
                Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,11,0"
                        Background="{DynamicResource Brush.Danger}">
                    <TextBlock Text="!" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Limits are not being enforced" FontWeight="SemiBold" />
                    <TextBlock Text="Rules remain editable, but BandwidthDesk must run as Administrator to shape traffic."
                               Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- At-a-glance metrics -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LIVE DOWNLOAD" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding TotalDownloadBps, Converter={StaticResource RateConv}, ConverterParameter=live}"
                                   Style="{StaticResource Text.Metric}" Margin="0,3,0,0" />
                        <TextBlock Text="Across tracked applications" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}">
                        <TextBlock Text="↓" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="LIVE UPLOAD" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding TotalUploadBps, Converter={StaticResource RateConv}, ConverterParameter=live}"
                                   Style="{StaticResource Text.Metric}" Margin="0,3,0,0" />
                        <TextBlock Text="Across tracked applications" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}">
                        <TextBlock Text="↑" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="VISIBLE APPS" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding VisibleApplicationCount}" Style="{StaticResource Text.Metric}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding VisibleProcessCount, StringFormat={}{0} running processes}" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xECAA;" FontSize="16" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ACTIVE RULES" Style="{StaticResource Text.Eyebrow}" />
                        <TextBlock Text="{Binding ActiveRuleCount}" Style="{StaticResource Text.Metric}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding SavedRuleCount, StringFormat={}{0} saved in total}" Style="{StaticResource Text.Subtle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource IconBadge}">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="16" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Core workflow -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*" MinWidth="650" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" MinWidth="390" />
            </Grid.ColumnDefinitions>

            <!-- Running applications -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,16,18,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Running applications" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Choose an app to create a persistent speed limit" Style="{StaticResource Text.Subtle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="Hide Microsoft" VerticalAlignment="Center"
                                  IsChecked="{Binding HideMicrosoftProcesses, Mode=TwoWay}"
                                  ToolTip="Hide Microsoft-signed and Windows system processes" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="18,0,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="ProcessSearchBox" Padding="34,8,10,8"
                                     AutomationProperties.Name="Search running applications"
                                     Text="{Binding ProcessFilter, UpdateSourceTrigger=PropertyChanged, Delay=180}" />
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="14"
                                       Foreground="{DynamicResource Brush.TextSubtle}" Margin="11,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock Text="Search apps, publishers, or descriptions" Margin="34,0,0,0"
                                       Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ProcessSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Command="{Binding RefreshProcessesCommand}" Padding="12,8" ToolTip="Refresh (F5)"
                                AutomationProperties.Name="Refresh applications">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="14" Margin="0,0,7,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="2" Margin="42,0,22,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SortHeader}" HorizontalAlignment="Left"
                                Command="{Binding SetSortCommand}" CommandParameter="Name">
                            <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SortHeaderText}">
                                <Binding Source="APPLICATION" /><Binding Source="Name" /><Binding Path="SortKey" /><Binding Path="SortDescending" />
                            </MultiBinding></TextBlock.Text></TextBlock>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Instances">
                            <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SortHeaderText}">
                                <Binding Source="INSTANCES" /><Binding Source="Instances" /><Binding Path="SortKey" /><Binding Path="SortDescending" />
                            </MultiBinding></TextBlock.Text></TextBlock>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Memory">
                            <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SortHeaderText}">
                                <Binding Source="MEMORY" /><Binding Source="Memory" /><Binding Path="SortKey" /><Binding Path="SortDescending" />
                            </MultiBinding></TextBlock.Text></TextBlock>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Download">
                            <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SortHeaderText}">
                                <Binding Source="DOWNLOAD" /><Binding Source="Download" /><Binding Path="SortKey" /><Binding Path="SortDescending" />
                            </MultiBinding></TextBlock.Text></TextBlock>
                        </Button>
                        <Button Grid.Column="4" Style="{StaticResource SortHeader}" HorizontalAlignment="Right"
                                Command="{Binding SetSortCommand}" CommandParameter="Upload">
                            <TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource SortHeaderText}">
                                <Binding Source="UPLOAD" /><Binding Source="Upload" /><Binding Path="SortKey" /><Binding Path="SortDescending" />
                            </MultiBinding></TextBlock.Text></TextBlock>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="3" Margin="10,0,8,0">
                        <TreeView x:Name="ProcessTree"
                                  ItemsSource="{Binding ProcessGroups}"
                                  SelectedItemChanged="ProcessTree_OnSelectedItemChanged"
                                  MouseDoubleClick="ProcessTree_OnMouseDoubleClick"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:ProcessGroupViewModel}"
                                                          ItemsSource="{Binding Children}"
                                                          ItemTemplate="{StaticResource ChildTemplate}">
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GroupTemplate}" />
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProcessItem_OnPreviewRightClick" />
                                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootWindow}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Add bandwidth limit…"
                                                          Command="{Binding PlacementTarget.Tag.NewRuleFromProcessNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="Edit matching rule…"
                                                          Command="{Binding PlacementTarget.Tag.EditRuleForProcessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>

                        <Border Background="{DynamicResource Brush.Surface}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProcessGroups.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310">
                                <Border Style="{StaticResource IconBadge}" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" FontSize="20"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No applications found" Style="{StaticResource Text.Header}"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="Try a different search or show Microsoft processes."
                                           Style="{StaticResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Padding="18,12" Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Select an application or expand it for a specific PID" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="Double-click is the fastest way to add or edit a rule" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Button.Accent}" Padding="16,9"
                                    Content="Limit selected…" Command="{Binding NewRuleFromSelectedProcessCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Saved rules -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,16,18,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Bandwidth rules" Style="{StaticResource Text.Header}" />
                            <TextBlock Text="Persistent limits enforced in listed order" Style="{StaticResource Text.Subtle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Accent}" Padding="12,8"
                                Command="{Binding NewBlankRuleCommand}" ToolTip="New rule (Ctrl+N)"
                                AutomationProperties.Name="New rule">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="17" Margin="0,-2,7,0" />
                                <TextBlock Text="New rule" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,8,0">
                        <ListBox x:Name="RulesList" ItemsSource="{Binding Rules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 ItemTemplate="{StaticResource RuleCardTemplate}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="RulesList_OnMouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RuleListItem}">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="RuleItem_OnPreviewRightClick" />
                                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=RootWindow}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Edit…" Command="{Binding EditRuleCommand}" />
                                                <MenuItem Header="Toggle enabled" Command="{Binding ToggleSelectedRuleCommand}" />
                                                <Separator />
                                                <MenuItem Header="Delete" Command="{Binding DeleteRuleCommand}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Border Background="{DynamicResource Brush.Surface}" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="270">
                                <Border Style="{StaticResource IconBadge}" Width="48" Height="48" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE9D9;" FontSize="20"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No limits yet" Style="{StaticResource Text.Header}"
                                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                                <TextBlock Text="Pick an application on the left or create a rule manually."
                                           Style="{StaticResource Text.Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Padding="18,12" Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Rule actions" Style="{StaticResource Text.Muted}" />
                                <TextBlock Text="Select a card to edit or remove it" Style="{StaticResource Text.Subtle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Edit" Margin="0,0,7,0" Command="{Binding EditRuleCommand}" />
                            <Button Grid.Column="2" Style="{StaticResource Button.Danger}" Content="Delete" Command="{Binding DeleteRuleCommand}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.TextSubtle}" Margin="0,0,7,0" />
                <TextBlock Text="{Binding LastRefreshMessage}" Style="{StaticResource Text.Subtle}" />
                <TextBlock Text="  ·  IPv4 + IPv6 TCP/UDP  ·  0 means unlimited" Style="{StaticResource Text.Subtle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="F5 refresh  ·  Ctrl+N new rule" Style="{StaticResource Text.Subtle}" />
        </Grid>
    </Grid>
</Window>
