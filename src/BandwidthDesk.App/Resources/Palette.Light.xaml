<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Bg"           Color="#FFF4F5F8" />
    <SolidColorBrush x:Key="Brush.Surface"      Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt"   Color="#FFF7F8FB" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#FFEEF0F5" />
    <SolidColorBrush x:Key="Brush.SurfaceActive" Color="#FFE3E7EF" />
    <SolidColorBrush x:Key="Brush.Border"       Color="#FFE2E5EC" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFCED2DB" />
    <SolidColorBrush x:Key="Brush.Divider"      Color="#11000000" />

    <SolidColorBrush x:Key="Brush.Text"         Color="#FF1B1D22" />
    <SolidColorBrush x:Key="Brush.TextMuted"    Color="#FF5F6470" />
    <SolidColorBrush x:Key="Brush.TextSubtle"   Color="#FF8C92A0" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Accent"       Color="#FF3B5BFF" />
    <SolidColorBrush x:Key="Brush.AccentHover"  Color="#FF5573FF" />
    <SolidColorBrush x:Key="Brush.AccentPress"  Color="#FF2C49E0" />
    <SolidColorBrush x:Key="Brush.AccentSoft"   Color="#333B5BFF" />

    <SolidColorBrush x:Key="Brush.Success"      Color="#FF1F9E55" />
    <SolidColorBrush x:Key="Brush.Warning"      Color="#FFB8740A" />
    <SolidColorBrush x:Key="Brush.Danger"       Color="#FFD13838" />
    <SolidColorBrush x:Key="Brush.DangerSoft"   Color="#22D13838" />

    <SolidColorBrush x:Key="Brush.Selection"    Color="#333B5BFF" />

    <Color x:Key="Color.Shadow">#33000000</Color>
</ResourceDictionary>
