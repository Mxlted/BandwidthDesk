<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BandwidthDesk.Core\BandwidthDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      WinDivert native binaries (WinDivert.dll + WinDivert64.sys) must be placed in
      native/x64/ before building. See README "Obtaining WinDivert" section.
      They are copied to the output directory at build time when present.
    -->
    <None Include="..\..\native\x64\WinDivert.dll" Condition="Exists('..\..\native\x64\WinDivert.dll')">
      <Link>WinDivert.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\native\x64\WinDivert64.sys" Condition="Exists('..\..\native\x64\WinDivert64.sys')">
      <Link>WinDivert64.sys</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
